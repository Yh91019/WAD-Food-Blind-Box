<!DOCTYPE html>
<html lang="en">
<head>
    CREATE TABLE cart(
    cart_id INT AUTO_INCREMENT PRIMARY KEY,
    restaurant VARCHAR(100),
    food_name VARCHAR(100),
    image VARCHAR(255),
    price DECIMAL(10,2),
    quantity INT
);
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shopping Cart</title>

    <link rel="stylesheet" href="cart.css">
</head>
<body>

<div class="container">

    <h1>🛒 My Cart</h1>

    <table>

        <tr>
            <th>Restaurant</th>
            <th>Food</th>
            <th>Quantity</th>
            <th>Price</th>
            <th>Remove</th>
        </tr>

        <tr>

            <td>McDonald's</td>

            <td>
                <img src="images/burger.jpg" class="food-img">
                Big Mac
            </td>

            <td>
                <button>-</button>
                <input type="number" value="1" min="1">
                <button>+</button>
            </td>

            <td>RM18.90</td>

            <td>
                <button class="remove">Remove</button>
            </td>

        </tr>

        <tr>

            <td>KFC</td>

            <td>
                <img src="images/chicken.jpg" class="food-img">
                Snack Plate
            </td>

            <td>
                <button>-</button>
                <input type="number" value="2" min="1">
                <button>+</button>
            </td>

            <td>RM29.80</td>

            <td>
                <button class="remove">Remove</button>
            </td>

        </tr>

    </table>

    <div class="delivery">

        <h3>Order Type</h3>

        <label>
            <input type="radio" name="delivery" checked>
            Pickup
        </label>

        <label>
            <input type="radio" name="delivery">
            Delivery
        </label>

    </div>

    <div class="summary">

        <h2>Total : RM48.70</h2>

        <button class="checkout">
            Checkout
        </button>

    </div>

</div>

</body>
</html>